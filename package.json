{
  "name": "labeleer-cli",
  "version": "1.0.0",
  "type": "module",
  "author": "Luca Warmenhoven",
  "private": false,
  "homepage": "https://labeleer.com",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run -u",
    "next:prod": "NODE_ENV=production next start",
    "check:types": "tsc --noEmit && rm tsconfig.tsbuildinfo",
    "build": "next typegen && npm run lint && npm run test && next build",
    "db:update": "tsx bin/db-migrations.ts --update",
    "start": "next start",
    "audit": "pnpm audit --audit-level=high --prod --registry=https://registry.npmjs.org",
    "lint:ci": "eslint \"./{src,bin}/**/*.{ts,tsx}\" --max-warnings 0 --cache",
    "lint": "eslint \"./{src,bin}/**/*.{ts,tsx}\" --max-warnings 0 --cache --fix",
    "lint:no-cycle": "eslint \"./{src,bin}/**/*.{ts,tsx}\" --cache --rule \"import/no-cycle: error\"",
    "generate:documentation-index": "echo 'Skipping docgen'",
    "import:labels": "tsx bin/import-labels.ts",
    "get:openapi": "tsx bin/import-spec.ts",
    "generate:client": "openapi-ts",
    "generate:api": "pnpm get:openapi && pnpm generate:client",
    "sanity": "next typegen && npm run test && npm run check:types && npm run lint"
  },
  "browserslist": [
    "defaults",
    "not dead"
  ],
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.1.2",
    "chalk": "^6.0.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "openapi-types": "^12.1.3",
    "ora": "^9.4.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
