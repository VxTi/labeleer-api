{
  "name": "@labeleer/api",
  "type": "module",
  "description": "Wrapper for Labeleer API interaction",
  "version": "1.0.0",
  "sideEffects": false,
  "private": false,
  "homepage": "https://labeleer.com",
  "license": "MIT",
  "author": "Luca Warmenhoven",
  "scripts": {
    "check:types": "tsc --noEmit && rm tsconfig.tsbuildinfo",
    "import:openapi": "tsx bin/import-spec.ts",
    "generate:client": "openapi-ts",
    "generate:api": "pnpm import:openapi && pnpm generate:client",
    "build": "npm run generate:api && tsc --p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.1.2",
    "chalk": "^6.0.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.7.4",
    "tsx": "4.23.12",
    "typescript": "^6.0.2",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
